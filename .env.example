# Optional locally. Without MONGO the app stores data in .data/
MONGO=
JWT_SECRET=

# Optional. A free CoinGecko Demo key gives steadier limits than keyless access.
COINGECKO_API_KEY=

# Optional. Without these, price alerts appear in the app only.
RESEND_API_KEY=
EMAIL_FROM=AcroCrypto <alerts@yourdomain.com>
APP_URL=http://localhost:5174

# How often to check alerts. Default is 10 minutes to protect the free API quota.
ALERT_CHECK_MS=600000
